# Copy to .env and fill in. .env is never committed.

# Web server (local only)
PORT=3000

# OpenCode Zen (https://opencode.ai/zen), for type-to-log and the eval
OPENCODE_API_KEY=
# Optional: any chat model on your OpenCode account (default deepseek-v4.1-flash)
AI_MODEL=

# Reminder email (Gmail: create an app password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
REMIND_TO=
# How many days ahead the reminder looks
REMIND_DAYS=30

# Optional: show one season's look instead of following the date (winter, spring, summer, autumn)
# SEASON=winter
